# Copy to .env (or run `make compose-env` from the repo root to generate random secrets).
AISTOR_LICENSE=
AISTOR_ROOT_USER=aistor-admin
AISTOR_ROOT_PASSWORD=change-me-root-password
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
REDIS_PASSWORD=change-me-redis
# 32 random bytes, base64: openssl rand -base64 32
AISTOR_UI_SESSION_KEY=
AISTOR_UI_OIDC_CLIENT_SECRET=change-me-oidc-client-secret
DEMO_ALICE_PASSWORD=change-me-alice
DEMO_BOB_PASSWORD=change-me-bob
